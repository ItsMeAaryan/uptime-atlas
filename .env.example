# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Optional: Number of consecutive failures before opening an incident (default: 3)
# INCIDENT_FAILURE_THRESHOLD=3

# Initial operator credentials for scripts/seed-operator.js (min 10 chars)
# OPERATOR_USERNAME="admin"
# OPERATOR_PASSWORD="your-strong-operator-password-here"

# Public application URL / origin (required in production, must be HTTPS, e.g. behind Cloudflare Tunnel)
# Defaults to http://localhost:3000 in development
# APP_URL="https://uptime.example.com"

# Whether to trust reverse-proxy headers (CF-Connecting-IP, X-Forwarded-For) for client IP extraction in rate limiting
# Set to "true" only when deployed behind a trusted reverse proxy (e.g. Cloudflare Tunnel, Nginx) that strips client-supplied headers
# Default: false
# TRUST_PROXY=true
